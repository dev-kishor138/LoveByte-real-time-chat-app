// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  displayName          String?
  lastSeenAt           DateTime?
  isVerified           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  sessions             Session[]
  otpCodes             OtpCode[]
  conversationsAsUser1 Conversation[] @relation("User1")
  conversationsAsUser2 Conversation[] @relation("User2")
  sentMessages         Message[]      @relation("SentMessages")
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String
  type        OtpType
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, isUsed])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  familyId   String   @default(uuid())
  deviceInfo String?
  ipAddress  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt, isRevoked])
}

model Conversation {
  id        String    @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user1     User      @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([updatedAt])
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  senderId         String
  clientMutationId String?
  type             MessageType  @default(TEXT)
  content          String?
  fileKey          String?
  fileMime         String?
  fileSize         Int?
  isEdited         Boolean      @default(false)
  editedAt         DateTime?
  isDeleted        Boolean      @default(false)
  readAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientMutationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([senderId])
}
