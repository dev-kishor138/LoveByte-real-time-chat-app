# Port number the HTTP server listens on (Render automatically injects PORT in production)
PORT=5000

# Runtime environment ('development' | 'test' | 'production')
NODE_ENV=development

# Pooled Neon PostgreSQL connection URL used by application runtime queries
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled Neon PostgreSQL connection URL (strictly required for Prisma migrations to prevent advisory-lock deadlocks)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cryptographically secure HMAC-SHA256 secret key for signing JWT access tokens (minimum 32 characters in production)
JWT_SECRET=supersecretjwtkeyreplaceinproductionwith32chars

# Access token validity window (defaults to 15m)
JWT_EXPIRES_IN=15m

# Refresh token retention window in days (defaults to 30)
REFRESH_TOKEN_EXPIRES_DAYS=30

# Comma-separated list of allowed web origins for CORS and Socket.IO handshakes
# NOTE: In production, wildcard '*' is disallowed and fails closed (rejects Origin-bearing requests).
# Native mobile clients (Android/iOS) do not send an Origin header and remain permitted.
CORS_ORIGIN=http://localhost:3000

# Optional: dedicated read-only connection URL for schema verification and audit scripts
# READONLY_DATABASE_URL="postgresql://lovebyte_readonly:YOUR_PASSWORD_HERE@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
